<?xml version="1.0" encoding="UTF-8"?>
<solver xmlns="https://timefold.ai/xsd/solver"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://timefold.ai/xsd/solver https://timefold.ai/xsd/solver/solver.xsd">

    <!-- FAST / REPRODUCIBLE for debugging -->
    <environmentMode>FAST_ASSERT</environmentMode>

    <!-- Domain -->
    <solutionClass>com.example.scheduler.domain.Schedule</solutionClass>
    <entityClass>com.example.scheduler.domain.ShiftAssignment</entityClass>

    <!-- Constraints -->
    <scoreDirectorFactory>
        <constraintProviderClass>com.example.scheduler.solver.ScheduleConstraintProvider</constraintProviderClass>
    </scoreDirectorFactory>

    <!-- Termination -->
    <termination>
        <secondsSpentLimit>30</secondsSpentLimit>
        <unimprovedSecondsSpentLimit>10</unimprovedSecondsSpentLimit>
    </termination>

    <!-- Construction Heuristic -->
    <constructionHeuristic/>

    <!-- Local Search: Simulated Annealing (benchmark winner) -->
    <localSearch>
        <unionMoveSelector>
            <changeMoveSelector/>
            <swapMoveSelector/>
        </unionMoveSelector>
        <acceptor>
            <simulatedAnnealingStartingTemperature>0hard/200soft</simulatedAnnealingStartingTemperature>
        </acceptor>
        <forager>
            <acceptedCountLimit>4</acceptedCountLimit>
        </forager>
    </localSearch>
</solver>