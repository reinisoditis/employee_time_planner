<?xml version="1.0" encoding="UTF-8"?>
<plannerBenchmark xmlns="https://timefold.ai/xsd/benchmark"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="https://timefold.ai/xsd/benchmark https://timefold.ai/xsd/benchmark/benchmark.xsd">

    <benchmarkDirectory>target/benchmark</benchmarkDirectory>
    <parallelBenchmarkCount>AUTO</parallelBenchmarkCount>

    <inheritedSolverBenchmark>
        <solver>
            <solutionClass>com.example.scheduler.domain.Schedule</solutionClass>
            <entityClass>com.example.scheduler.domain.ShiftAssignment</entityClass>
            <scoreDirectorFactory>
                <constraintProviderClass>com.example.scheduler.solver.ScheduleConstraintProvider</constraintProviderClass>
            </scoreDirectorFactory>
            <termination>
                <secondsSpentLimit>30</secondsSpentLimit>
            </termination>
        </solver>
    </inheritedSolverBenchmark>

    <!-- 1. BASELINE: Timefold default configuration -->
    <solverBenchmark>
        <name>1_Default_Baseline</name>
        <solver>
            <constructionHeuristic/>
            <localSearch/>
        </solver>
    </solverBenchmark>

    <!-- 2. TABU SEARCH: Classic metaheuristic (shows limitations) -->
    <solverBenchmark>
        <name>2_Tabu_Search</name>
        <solver>
            <constructionHeuristic/>
            <localSearch>
                <unionMoveSelector>
                    <changeMoveSelector/>
                    <swapMoveSelector/>
                </unionMoveSelector>
                <acceptor>
                    <entityTabuSize>15</entityTabuSize>
                </acceptor>
                <forager>
                    <acceptedCountLimit>4</acceptedCountLimit>
                </forager>
            </localSearch>
        </solver>
    </solverBenchmark>

    <!-- 3. LATE ACCEPTANCE: History-based diversification -->
    <solverBenchmark>
        <name>3_Late_Acceptance</name>
        <solver>
            <constructionHeuristic/>
            <localSearch>
                <unionMoveSelector>
                    <changeMoveSelector/>
                    <swapMoveSelector/>
                </unionMoveSelector>
                <acceptor>
                    <lateAcceptanceSize>400</lateAcceptanceSize>
                </acceptor>
                <forager>
                    <acceptedCountLimit>4</acceptedCountLimit>
                </forager>
            </localSearch>
        </solver>
    </solverBenchmark>

    <!-- 4. SIMULATED ANNEALING: Best performer on large problems -->
    <solverBenchmark>
        <name>4_Simulated_Annealing</name>
        <solver>
            <constructionHeuristic/>
            <localSearch>
                <unionMoveSelector>
                    <changeMoveSelector/>
                    <swapMoveSelector/>
                </unionMoveSelector>
                <acceptor>
                    <simulatedAnnealingStartingTemperature>0hard/200soft</simulatedAnnealingStartingTemperature>
                </acceptor>
                <forager>
                    <acceptedCountLimit>4</acceptedCountLimit>
                </forager>
            </localSearch>
        </solver>
    </solverBenchmark>

    <!-- 5. HYBRID: Tabu + Simulated Annealing combined -->
    <solverBenchmark>
        <name>5_Hybrid_Tabu_SA</name>
        <solver>
            <constructionHeuristic/>
            <localSearch>
                <unionMoveSelector>
                    <changeMoveSelector/>
                    <swapMoveSelector/>
                </unionMoveSelector>
                <acceptor>
                    <entityTabuSize>7</entityTabuSize>
                    <simulatedAnnealingStartingTemperature>0hard/100soft</simulatedAnnealingStartingTemperature>
                </acceptor>
                <forager>
                    <acceptedCountLimit>4</acceptedCountLimit>
                </forager>
            </localSearch>
        </solver>
    </solverBenchmark>

</plannerBenchmark>